# Copy to .env and fill in. NEVER use a live Stripe key - the app refuses to start with one.
ANTHROPIC_API_KEY=sk-ant-...
# Stripe Dashboard (Test mode toggle ON) > Developers > API keys. sk_test_... or a restricted rk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Optional
OSCAR_MODEL=claude-opus-5-5
OSCAR_EFFORT=medium
OSCAR_FALLBACKS=1
OSCAR_MAX_TURNS=25
# OSCAR_POLICY=policy.yaml
# OSCAR_AUDIT_DB=data/audit.db
OSCAR_INBOX=scenarios/inbox_demo.json   # 4-message demo inbox (default: scenarios/inbox.json, 6 messages)
OSCAR_MEMORY=cognee                      # 'keyword' disables Cognee
